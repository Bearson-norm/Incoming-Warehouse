# Copy to .env next to docker-compose.yml before `docker compose up`.
# Compose fails if POSTGRES_PASSWORD, JWT_SECRET, GATEWAY_API_KEY, or CLOUD_SYNC_API_KEY are unset.

POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=wis_foom

# VPS API auth (admin login on VPS DB; also used to verify JWT forwarded from Electron if jwtSecret matches)
JWT_SECRET=

# Used by VPS API only (Gateway on weighing PCs uses its own local key)
GATEWAY_API_KEY=

# First-run admin user on empty PostgreSQL (username: admin)
ADMIN_INITIAL_PASSWORD=

# Odoo WMS IoT weighing (optional on cloud VPS unless you use Odoo from this API)
ODOO_BASE_URL=http://YOUR_ODOO_HOST:8069
ODOO_IOT_API_KEY=your-foom-iot-api-key

# MUST match cloud.syncApiKey on every Electron station (Settings → Cloud)
CLOUD_SYNC_API_KEY=

# Optional. Electron sync is server-to-server; only needed if a browser calls this API directly.
CORS_ORIGIN=https://wis.moof-set.web.id

# --- Pairing with Electron (see Software/CLOUD_SETUP.md) ---
# cloud.serverUrl  = public URL of this VPS (no trailing slash), NOT set in this file
# cloud.syncApiKey = same as CLOUD_SYNC_API_KEY above
# jwtSecret (Electron config.json) = same as JWT_SECRET above, if admins manage scales from Electron
