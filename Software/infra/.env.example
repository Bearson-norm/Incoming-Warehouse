# Copy to .env next to docker-compose.yml before `docker compose up`.
# Compose fails if POSTGRES_PASSWORD, JWT_SECRET, or GATEWAY_API_KEY are unset.

POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=wis_foom

JWT_SECRET=
GATEWAY_API_KEY=

# Optional first-run admin password for empty databases
ADMIN_INITIAL_PASSWORD=

# Odoo WMS IoT weighing (Recording Action confirm)
ODOO_BASE_URL=http://YOUR_ODOO_HOST:8069
ODOO_IOT_API_KEY=your-foom-iot-api-key

# Cloud storage sync (local stations push weighing data with this key)
CLOUD_SYNC_API_KEY=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGIN=https://wis.moof-set.web.id,http://wis.moof-set.web.id
