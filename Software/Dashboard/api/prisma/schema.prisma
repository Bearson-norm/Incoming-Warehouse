generator client {
  provider = "prisma-client-js"
}

// VPS / docker API uses this PostgreSQL schema.
// Packaged Electron (local device) uses prisma-sqlite/schema.prisma.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("user") // 'admin', 'user'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions WeighSession[]
}

model Vendor {
  id        Int       @id @default(autoincrement())
  cloudId   String    @unique @default(cuid())
  name      String
  revision  Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  packagings    Packaging[]
  weighSessions WeighSession[]

  @@index([updatedAt])
  @@index([deletedAt])
}

model Packaging {
  id         Int       @id @default(autoincrement())
  cloudId    String    @unique @default(cuid())
  vendorId   Int
  name       String
  tareWeight Float?
  metadata   String?
  revision   Int       @default(1)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  weighSessions WeighSession[]

  @@index([vendorId, deletedAt])
  @@index([updatedAt])
}

model RmCode {
  id        Int       @id @default(autoincrement())
  cloudId   String    @unique @default(cuid())
  code      String    @unique
  name      String?
  issuedAt  DateTime  @default(now())
  revision  Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  weighSessions WeighSession[]

  @@index([updatedAt])
  @@index([deletedAt])
}

model WeighSession {
  id              Int       @id @default(autoincrement())
  userId          Int
  vendorId        Int?
  packagingId     Int?
  rmCodeId        Int?
  /// Admin-defined cloud scale identifier selected before weighing
  scaleId         Int?
  scaleName       String?
  /// Barcode LPN / package_uid untuk integrasi Odoo WMS
  packageUid      String?
  /// Scale gateway that produced the live weight for this session
  gatewayId       String?
  /// 'odoo' | 'internal'
  weighingMethod  String    @default("odoo")
  /// 'incoming' | 'intrans'
  flowType        String    @default("incoming")
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  autosaveEnabled Boolean   @default(true)
  weighingStarted Boolean   @default(false)
  /// Snapshot field label (legacy cetak label)
  labelMetadata   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  vendor    Vendor?        @relation(fields: [vendorId], references: [id])
  packaging Packaging?     @relation(fields: [packagingId], references: [id])
  rmCode    RmCode?        @relation(fields: [rmCodeId], references: [id], onDelete: SetNull)
  readings  WeighReading[]

  @@index([packageUid])
  @@index([gatewayId])
  @@index([scaleId])
  @@index([userId, endedAt])
  @@index([weighingMethod])
  @@index([flowType])
}

model WeighReading {
  id             Int       @id @default(autoincrement())
  sessionId      Int
  weight         Float
  unit           String    @default("kg")
  stable         Boolean
  rawLine        String?
  capturedAt     DateTime  @default(now())
  savedAt        DateTime?
  createdAt      DateTime  @default(now())
  packageUid     String?
  odooLogId      Int?
  odooPackageId  Int?
  grossWeight    Float?
  tareWeight     Float?
  netWeight      Float?
  weightStatus   String?
  odooMessage    String?
  odooError      String?
  cloudSyncedAt  DateTime?
  cloudSyncError String?

  session WeighSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([capturedAt])
  @@index([packageUid])
  @@index([cloudSyncedAt])
}

model CloudScale {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings CloudWeighReading[]

  @@index([isActive])
}

model CloudWeighReading {
  id                Int      @id @default(autoincrement())
  eventId           String?  @unique
  scaleId           Int
  scaleName         String
  username          String
  stationId         String?
  deviceId          String?
  gatewayId         String?
  localReadingId    Int?
  localSessionId    Int?
  packageUid        String?
  vendorCloudId     String?
  vendorSnapshot    String?
  packagingCloudId  String?
  packagingSnapshot String?
  rmCodeCloudId     String?
  rmCodeSnapshot    String?
  labelMetadata     String?
  odooLogId         Int?
  odooPackageId     Int?
  flowType          String
  weighingMethod    String
  weight            Float
  grossWeight       Float?
  tareWeight        Float?
  netWeight         Float?
  unit              String   @default("kg")
  weightStatus      String?
  capturedAt        DateTime
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scale CloudScale @relation(fields: [scaleId], references: [id])

  @@unique([stationId, localReadingId])
  @@index([username])
  @@index([scaleId])
  @@index([capturedAt])
  @@index([stationId])
  @@index([packageUid, capturedAt])
  @@index([vendorCloudId])
  @@index([rmCodeCloudId])
}

model MasterDataAuditEvent {
  id            String   @id @default(cuid())
  entityType    String
  entityCloudId String
  action        String
  revision      Int
  beforeJson    Json?
  afterJson     Json?
  reason        String
  actorUserId   Int?
  actorUsername String
  stationId     String?
  deviceId      String?
  requestId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityType, entityCloudId, revision])
  @@index([createdAt])
  @@index([actorUsername])
}

model LpnTraceEvent {
  id           String   @id @default(cuid())
  stationId    String
  localEventId String
  packageUid   String
  eventType    String
  username     String
  deviceId     String?
  gatewayId    String?
  scaleId      Int?
  scaleName    String?
  sourceAt     DateTime
  receivedAt   DateTime @default(now())
  payload      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([stationId, localEventId])
  @@index([packageUid, sourceAt])
  @@index([stationId, sourceAt])
  @@index([eventType])
}

model Gateway {
  id         Int       @id @default(autoincrement())
  name       String
  gatewayId  String    @unique
  apiKey     String    @unique
  lastSeenAt DateTime?
  os         String?
  version    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([gatewayId])
}
