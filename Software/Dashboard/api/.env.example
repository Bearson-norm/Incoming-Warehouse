# VPS / docker API: PostgreSQL
# Local Electron devices ignore this file and use SQLite next to the exe.
DATABASE_URL="postgresql://admin:CHANGE_ME@localhost:5432/wis_foom?schema=public"
JWT_SECRET=change-me-in-production-use-long-random-string
GATEWAY_API_KEY=change-me-in-production-use-long-random-string
PORT=4123
CORS_ORIGIN=http://localhost:4234,http://YOUR_VPS_IP:4234
NODE_ENV=development

# First-run admin (required in production)
# ADMIN_INITIAL_PASSWORD=use-a-strong-password

# Odoo WMS — default (bisa di-override lewat Pengaturan → PATCH /api/settings/odoo)
ODOO_BASE_URL=http://IP_ODOO_SERVER:8069
ODOO_IOT_API_KEY=your-foom-iot-api-key
# ODOO_SETTINGS_FILE=./data/odoo-settings.json

# Cloud server (VPS storage for scales + aggregated weighing data)
# Local SQLite stations set these to sync to VPS; VPS API uses CLOUD_SYNC_API_KEY to accept sync writes.
CLOUD_SERVER_URL=https://your-vps.example.com
CLOUD_SYNC_API_KEY=change-me-in-production-use-long-random-string
STATION_ID=
# CLOUD_SETTINGS_FILE=./data/cloud-settings.json
