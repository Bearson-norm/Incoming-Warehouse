# --- Local development (npm run start:dev on a PC) ---
# Use PostgreSQL locally OR SQLite for Electron-like testing:
# DATABASE_URL="file:./data/incoming-warehouse.db"
DATABASE_URL="postgresql://admin:CHANGE_ME@localhost:5432/wis_foom?schema=public"

JWT_SECRET=change-me-in-production-use-long-random-string
GATEWAY_API_KEY=change-me-in-production-use-long-random-string
PORT=4123
# Dev web UI (Vite/Electron); not used on VPS API-only deploy
CORS_ORIGIN=http://localhost:4234
NODE_ENV=development

# ADMIN_INITIAL_PASSWORD=use-a-strong-password

ODOO_BASE_URL=http://IP_ODOO_SERVER:8069
ODOO_IOT_API_KEY=your-foom-iot-api-key
# ODOO_SETTINGS_FILE=./data/odoo-settings.json

# --- Electron station → VPS cloud (SQLite + remote mode) ---
# Set via Electron Settings or env when running API outside Electron:
CLOUD_SERVER_URL=https://your-vps.example.com
CLOUD_SYNC_API_KEY=change-me-same-as-vps-infra-env
STATION_ID=
# CLOUD_SETTINGS_FILE=./data/cloud-settings.json

# VPS Docker: use Software/infra/.env instead of this file for production API on server.
