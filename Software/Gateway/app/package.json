{
  "name": "@incoming-warehouse/gateway",
  "version": "1.0.0",
  "description": "Gateway app for reading scale data via Serial and forwarding to VPS via WebSocket",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "detect-ports": "node scripts/detect-ports.js"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "@serialport/parser-readline": "^12.0.0",
    "socket.io-client": "^4.6.1",
    "dotenv": "^16.3.1",
    "commander": "^11.1.0",
    "uuid": "^9.0.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@types/better-sqlite3": "^7.6.8",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "bin": {
    "gateway": "./dist/index.js"
  }
}
